# Copy to .env and load it (e.g. `set -a; . ./.env; set +a`). Never commit real values.

# --- Auth provider: local | google | aws --------------------------------------
AUTH_PROVIDER=local
JWT_SECRET=change-me-to-a-long-random-string-32chars+
JWT_TTL_SECONDS=3600

# Admin seeded on first boot. Local mode: default password, forced change at first login.
ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=Admin@123

# Google SSO (AUTH_PROVIDER=google)
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=            # optional, e.g. yourcompany.com

# AWS Cognito SSO (AUTH_PROVIDER=aws)
AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Databricks Genie via Unity Catalog (empty = mock mode) -------------------
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_AUTH_MODE=service_principal   # service_principal | user_pat
DATABRICKS_CLIENT_ID=            # service principal OAuth M2M (preferred)
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TOKEN=                # or a static service PAT (service_principal mode)
GATEWAY_ENCRYPTION_KEY=          # Fernet key; required for user_pat mode
DATABRICKS_ACCOUNT_ID=           # empty = workspace directory; set = account-level SCIM
SUMMARIZER_PROVIDER=none         # none | openai | anthropic
SUMMARIZER_API_KEY=
SUMMARIZER_MODEL=
SUMMARIZER_MAX_CHARS=8000
DATABRICKS_PAT_AUTH=true         # accept user and service PATs as MCP bearer tokens
DATABRICKS_PAT_CACHE_SECONDS=300 # how long a verified PAT identity is cached
GENIE_SPACE_ID=
GENIE_POLL_SECONDS=2
JOB_TIMEOUT_SECONDS=300

# --- Slack and Jira (empty = mock mode) ---------------------------------------
SLACK_USER_TOKEN=                # xoxp-... (search.messages needs a user token)
JIRA_BASE_URL=https://<site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Server --------------------------------------------------------------------
DB_PATH=data/gateway.db
HOST=127.0.0.1
PORT=8000

# --- HTTPS and OAuth (MCP clients such as ChatGPT) -----------------------------
PUBLIC_HOST=gw.example.com         # DNS name pointing at this server (Caddy certificate)
PUBLIC_BASE_URL=https://gw.example.com
# Either serve TLS directly:
TLS_CERT_FILE=
TLS_KEY_FILE=
# or sit behind a proxy and trust it:
TRUSTED_PROXY_IPS=
OAUTH_ENABLED=true
OAUTH_ACCESS_TOKEN_SECONDS=3600
OAUTH_REFRESH_TOKEN_SECONDS=2592000
OAUTH_ALLOW_DYNAMIC_REGISTRATION=true
